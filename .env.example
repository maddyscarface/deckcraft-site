# ---- Public (safe in the browser) ----
NEXT_PUBLIC_SITE_URL=https://deckcraftbuild.com
# Canonicals always use a real custom domain, never a *.vercel.app host.
# Production stays noindex until this flag is set to true after the domain is confirmed.
NEXT_PUBLIC_INDEXABLE_SITE=        # "true" only after owner approval of the production domain
NEXT_PUBLIC_PHONE=                 # e.g. (617) 555-0100 — leave blank to hide phone CTAs
NEXT_PUBLIC_PHONE_E164=            # e.g. +16175550100
NEXT_PUBLIC_RESPONSE_HOURS=        # e.g. 4 — only once the team can reliably meet it
NEXT_PUBLIC_GTM_ID=                # GTM-XXXXXXX
NEXT_PUBLIC_GA4_ID=                # G-XXXXXXXXXX (server MP; tag loads directly ONLY when no GTM id is set)
NEXT_PUBLIC_GOOGLE_ADS_ID=         # AW-XXXXXXXXX (direct gtag when no GTM; otherwise configure in GTM)
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL= # conversion label for "Lead" (transaction_id = event_id for dedup)
NEXT_PUBLIC_CONTACT_EMAIL=         # defaults to info@deckcraftbuild.com
NEXT_PUBLIC_INSTAGRAM_URL=         # social links render only when set
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GHL_CALENDAR_URL=      # GHL walkthrough calendar widget URL
NEXT_PUBLIC_CONSENT_DEFAULT=granted   # or "denied" for opt-in banner

# ---- Server only (never prefix with NEXT_PUBLIC_) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# GoHighLevel. Order of preference: API v2 (token + location) → inbound webhook → LOG mode (nothing sent).
GHL_API_TOKEN=                     # Private Integration token for the DeckCraft sub-account (contacts, opportunities, workflows scopes)
GHL_LOCATION_ID=
GHL_PIPELINE_RESIDENTIAL_ID=       # "DeckCraft · Residential"
GHL_PIPELINE_COMMERCIAL_ID=        # "DeckCraft · Property Programs"
GHL_STAGE_IDS=                     # JSON {"residential":{"new_lead":"…","photos_received":"…",…},"commercial":{…}}
GHL_CUSTOM_FIELD_IDS=              # JSON {"dc_lead_score":"…","dc_lead_tier":"…",…} (see src/config/ghl.ts)
GHL_WORKFLOW_IDS=                  # JSON {"speed_to_lead":"…","hot_lead_alert":"…",…} (optional; tags wf:* always applied)
GHL_OWNER_IDS=                     # JSON {"residential":"<userId>","commercial":"<userId>","MetroWest":"<userId>"} sales owner (geography wins)
GHL_WEBHOOK_URL=                   # DeckCraft sub-account inbound webhook trigger URL (fallback)
GHL_WEBHOOK_SECRET=                # long random string; GHL sends it as x-dc-secret to /api/crm-webhook
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=              # set only while testing in Events Manager
GA4_API_SECRET=
ADMIN_PASSWORD=                    # basic auth for /admin and /api/admin/* (attribution report)
GOOGLE_ADS_OFFLINE_CONVERSION_NAME= # e.g. "DeckCraft Won Job" for /api/admin/attribution?format=gads
SITE_NOINDEX=                      # "1" on staging (Vercel previews are noindex automatically)
ALLOW_LOCAL_STORE=                 # "1" only on staging/dev: in-memory/local lead store when no Supabase
CRON_SECRET=                       # Vercel Cron bearer for /api/cron/retry-ghl
OWNER_ALERT_EMAIL=
RESEND_API_KEY=

# --- OpenAI Ads (ChatGPT ads) — Ads Manager → Conversions tab ---
# Browser pixel (public). Loads only after advertising consent; GPC always blocks it.
NEXT_PUBLIC_OPENAI_PIXEL_ID=
# Set "true" while testing to log pixel activity in the browser console.
NEXT_PUBLIC_OPENAI_PIXEL_DEBUG=
# Conversions API (server only, never expose). Must use the SAME pixel id as above for dedup.
OPENAI_ADS_PIXEL_ID=
OPENAI_ADS_API_KEY=
# "true" = OpenAI validates events but does not record them. Turn off at launch.
OPENAI_ADS_VALIDATE_ONLY=true
OPENAI_ADS_INTEGRATION_SOURCE=

# --- Team lead brief email (budget, start, saw pricing, requested visit time, add-to-calendar) ---
# Sent through Resend (RESEND_API_KEY). LEAD_BRIEF_TO is comma-separated; falls back to OWNER_ALERT_EMAIL.
LEAD_BRIEF_FROM=
LEAD_BRIEF_TO=

# --- Content-Security-Policy ---
# CSP ships as Report-Only (allows OpenAI pixel bzrcdn/bzr.openai.com, GTM/GA4, Meta, Turnstile, GHL, Supabase).
# Check the browser console for violations after GTM is live, then set "true" to enforce.
CSP_ENFORCE=

# --- Intent data (DataMoon / AudienceLab) — DISABLED BY DEFAULT; privacy review first ---
INTENT_ENABLED=                    # "true" to accept /api/intent/webhook (404 otherwise)
INTENT_PROVIDER=                   # datamoon | audiencelab
INTENT_WEBHOOK_SECRET=             # sent by the provider as x-intent-secret
INTENT_MIN_SCORE=60
NEXT_PUBLIC_INTENT_ENABLED=        # "true" to load the consent-gated browser pixel
NEXT_PUBLIC_INTENT_PIXEL_SRC=
INTENT_PIXEL_HOST=                 # origin added to CSP, e.g. https://cdn.provider.com

# Seasonal modules (src/config/seasonal.ts). Optional admin overrides.
SEASONAL_MODULES_JSON=              # JSON array of {id,start:"MM-DD",end:"MM-DD",enabled,label,bar,headline,body,cta:{label,href}}
SEASONAL_FORCE=                     # <module id> | evergreen | off
