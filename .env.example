# ---- Public (safe in the browser) ----
NEXT_PUBLIC_SITE_URL=https://deckcraftboston.com
NEXT_PUBLIC_PHONE=                 # e.g. (617) 555-0100 — leave blank to hide phone CTAs
NEXT_PUBLIC_PHONE_E164=            # e.g. +16175550100
NEXT_PUBLIC_RESPONSE_HOURS=        # e.g. 4 — only once the team can reliably meet it
NEXT_PUBLIC_GTM_ID=                # GTM-XXXXXXX
NEXT_PUBLIC_GA4_ID=                # G-XXXXXXXXXX (used by server MP; GA4 tag itself lives in GTM)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GHL_CALENDAR_URL=      # GHL walkthrough calendar widget URL
NEXT_PUBLIC_CONSENT_DEFAULT=granted   # or "denied" for opt-in banner

# ---- Server only (never prefix with NEXT_PUBLIC_) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GHL_WEBHOOK_URL=                   # DeckCraft sub-account inbound webhook trigger URL
GHL_WEBHOOK_SECRET=                # long random string; GHL sends it as x-dc-secret to /api/crm-webhook
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=              # set only while testing in Events Manager
GA4_API_SECRET=
ADMIN_PASSWORD=                    # basic auth for /admin
CRON_SECRET=                       # Vercel Cron bearer for /api/cron/retry-ghl
OWNER_ALERT_EMAIL=
RESEND_API_KEY=

# --- OpenAI Ads (ChatGPT ads) — Ads Manager → Conversions tab ---
# Browser pixel (public). Loads only after advertising consent; GPC always blocks it.
NEXT_PUBLIC_OPENAI_PIXEL_ID=
# Set "true" while testing to log pixel activity in the browser console.
NEXT_PUBLIC_OPENAI_PIXEL_DEBUG=
# Conversions API (server only, never expose). Must use the SAME pixel id as above for dedup.
OPENAI_ADS_PIXEL_ID=
OPENAI_ADS_API_KEY=
# "true" = OpenAI validates events but does not record them. Turn off at launch.
OPENAI_ADS_VALIDATE_ONLY=true
OPENAI_ADS_INTEGRATION_SOURCE=

# --- Team lead brief email (budget, start, saw pricing, requested visit time, add-to-calendar) ---
# Sent through Resend (RESEND_API_KEY). LEAD_BRIEF_TO is comma-separated; falls back to OWNER_ALERT_EMAIL.
LEAD_BRIEF_FROM=
LEAD_BRIEF_TO=

# --- Content-Security-Policy ---
# CSP ships as Report-Only (allows OpenAI pixel bzrcdn/bzr.openai.com, GTM/GA4, Meta, Turnstile, GHL, Supabase).
# Check the browser console for violations after GTM is live, then set "true" to enforce.
CSP_ENFORCE=
